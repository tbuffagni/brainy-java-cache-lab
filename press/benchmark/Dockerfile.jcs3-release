ARG BUILD_IMAGE=maven:3.9.11-eclipse-temurin-25@sha256:407c4423cec0cf2981055bc2c6c0dc211d9605b6669279b95997f2d1c7e91e2c
ARG RUNTIME_IMAGE=tomcat:11.0.24-jdk25-temurin-noble@sha256:6d673ad42da6498f05755cae67f85f2128bdfd88943c9bdb22e0965f8d4c3182
ARG JCS_VERSION=3.2.1
ARG JCS_COMMIT=maven-central-3.2.1
ARG JCS_COORDINATES=org.apache.commons:commons-jcs3-core:3.2.1

FROM ${BUILD_IMAGE} AS build
ARG JCS_VERSION

# A dedicated Maven cache prevents a locally patched 3.2.1 artifact from
# shadowing the binary distributed by Maven Central.
WORKDIR /workspace
COPY pom.xml ./
COPY src ./src
COPY press/benchmark/jcs3-release/ProviderFactory.java \
    ./src/main/java/it/tekne/benchmark/cache/ProviderFactory.java
RUN --mount=type=cache,id=cache-benchmark-m2-jcs3-release,target=/root/.m2 \
    mvn -B -Djcs.version=${JCS_VERSION} clean verify && \
    sha256sum \
    /root/.m2/repository/org/apache/commons/commons-jcs3-core/${JCS_VERSION}/commons-jcs3-core-${JCS_VERSION}.jar \
    > /tmp/commons-jcs3-core.sha256

FROM ${RUNTIME_IMAGE}
ARG JCS_VERSION
ARG JCS_COMMIT
ARG JCS_COORDINATES

LABEL org.opencontainers.image.title="Beyond Throughput JCS release lifecycle benchmark" \
      org.opencontainers.image.description="Published Apache Commons JCS release lifecycle validation" \
      org.opencontainers.image.version.jcs="${JCS_VERSION}" \
      org.opencontainers.image.revision.jcs="${JCS_COMMIT}"

ENV JAVA_OPTS="-Xms256m -Xmx768m -XX:+UseG1GC -XX:NativeMemoryTracking=summary -Djava.awt.headless=true"
ENV CACHE_BENCH_JCS_VERSION="${JCS_VERSION}" \
    CACHE_BENCH_JCS_COMMIT="${JCS_COMMIT}" \
    CACHE_BENCH_JCS_COORDINATES="${JCS_COORDINATES}"

RUN cp -R /usr/local/tomcat/webapps.dist/manager /usr/local/tomcat/webapps/manager

COPY docker/tomcat-users.xml /usr/local/tomcat/conf/tomcat-users.xml
COPY docker/manager-context.xml /usr/local/tomcat/webapps/manager/META-INF/context.xml
COPY --from=build /workspace/target/cache-benchmark.war /artifacts/cache-benchmark.war
COPY --from=build /tmp/commons-jcs3-core.sha256 /artifacts/commons-jcs3-core.sha256

EXPOSE 8080
